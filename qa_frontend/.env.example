# Environment variables for qa_frontend (consumed by index.html script or deployment)
# The orchestrator should expose these as global variables for runtime overrides.
# Example mapping (in deployment): window.__QA_API_BASE_URL__ and window.__QA_WS_URL__
QA_API_BASE_URL=https://api.example.com/api
QA_WS_URL=wss://api.example.com/ws
